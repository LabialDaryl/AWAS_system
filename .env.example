# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Payment Gateway API Keys
GCASH_API_KEY=your_gcash_api_key
GCASH_API_SECRET=your_gcash_api_secret
GCASH_MERCHANT_ID=your_gcash_merchant_id

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

PAYMAYA_PUBLIC_KEY=your_paymaya_public_key
PAYMAYA_SECRET_KEY=your_paymaya_secret_key
PAYMAYA_ENVIRONMENT=sandbox

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Water Billing Settings
MINIMUM_CUBIC_METERS=10
RATE_PER_CUBIC_METER=15.00
MINIMUM_CHARGE=150.00
LATE_PAYMENT_PENALTY=50.00
RECONNECTION_FEE=500.00

# Notification Settings
NOTIFICATION_DAYS_BEFORE_DUE=3
NOTIFICATION_DAYS_BEFORE_DISCONNECTION=1
